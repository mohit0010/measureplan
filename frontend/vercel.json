{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "18",
      "ENABLE_EXPERIMENTAL_COREPACK": "1"
    }
  },
  "installCommand": "yarn install",
  "buildCommand": "yarn build"
}