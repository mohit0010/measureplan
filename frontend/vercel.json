{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://measureplan-gold.vercel.app/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "build": {
    "env": {
      "NODE_VERSION": "18"
    }
  }
}